---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { nav, zap } from '../data/links';
const atual = Astro.url.pathname.replace(/\/$/, '');
---
<header class="sticky top-0 z-40 bg-ceu-claro">
  <div class="pagina wrap flex items-center justify-between gap-4 py-3">
    <a href="/" class="flex items-center gap-3 no-underline text-marinho whitespace-nowrap" aria-label="Bicho Forte, página inicial">
      <Image src={logo} alt="" width={44} height={44} widths={[88, 132]} sizes="44px" class="rounded-full" />
      <span class="font-display text-2xl font-semibold tracking-tight">Bicho Forte</span>
    </a>
    <nav aria-label="Principal" class="hidden lg:flex items-center gap-7 font-bold">
      {nav.map((l) => (
        <a href={l.href} class:list={['no-underline hover:underline', atual === l.href && 'underline']} aria-current={atual === l.href ? 'page' : undefined}>{l.rotulo}</a>
      ))}
    </nav>
    <div class="flex items-center gap-2">
      <a href={zap()} class="btn btn-zap hidden md:inline-flex" data-evento="click_whatsapp">Chamar no WhatsApp</a>
      <details class="lg:hidden relative">
        <summary class="btn btn-marinho list-none cursor-pointer" aria-label="Abrir menu">Menu</summary>
        <nav aria-label="Menu móvel" class="absolute right-0 mt-2 w-64 bg-white rounded-[20px] p-3 flex flex-col">
          {nav.map((l) => <a href={l.href} class="px-4 py-3 rounded-xl no-underline font-bold hover:bg-ceu-claro">{l.rotulo}</a>)}
        </nav>
      </details>
    </div>
  </div>
</header>
