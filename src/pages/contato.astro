---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import n from '../data/negocio.json';
import { zap } from '../data/links';
import fachada from '../assets/fachada.jpg';
const jsonld = [{ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Início', item: n.url }, { '@type': 'ListItem', position: 2, name: 'Contato', item: `${n.url}/contato` }] }];
---
<Base title="Contato e como chegar | Bicho Forte, Praia Grande" description="Av. Mal. Mallet, 504, Canto do Forte, Praia Grande. Segunda a sábado, das 9h às 20h. WhatsApp (13) 98123-6882 e telefone (13) 3491-4464." path="/contato" jsonld={jsonld}>
  <section class="pagina wrap pt-1">
    <div class="grid lg:grid-cols-12 gap-3">
      <div class="lg:col-span-6 bg-ceu rounded-[20px] p-6 sm:p-12 lg:py-16">
        <h1 class="rev text-[length:var(--t-xl)]">Venha nos visitar.</h1>
        <p class="rev mt-5 text-xl" style="--i:1">{n.endereco.rua}<br />{n.endereco.bairro}, {n.endereco.cidade} – {n.endereco.uf}<br />CEP {n.endereco.cep}</p>
        <p class="rev mt-4 font-bold" style="--i:2"><span data-status>Segunda a sábado, das 9h às 20h</span></p>
        <div class="rev mt-7 flex flex-wrap gap-3" style="--i:3">
          <a href={n.rota} class="btn btn-marinho" rel="noopener noreferrer" target="_blank" data-evento="click_rota">Ver como chegar</a>
          <a href={zap()} class="btn btn-zap" data-evento="click_whatsapp">Chamar no WhatsApp</a>
        </div>
      </div>
      <div class="lg:col-span-6 relative rounded-[20px] overflow-hidden min-h-[300px]">
        <Image src={fachada} alt="Fachada da Bicho Forte na Av. Mal. Mallet, 504" widths={[640, 960, 1200]} sizes="(min-width:1024px) 50vw, 100vw" loading="eager" class="absolute inset-0 w-full h-full object-cover" />
      </div>
    </div>
  </section>
  <section class="pagina wrap py-20 grid gap-10 md:grid-cols-3">
    <div class="bg-white rounded-[20px] p-6">
      <h2 class="text-[length:var(--t-h3)]">Horário</h2>
      <dl class="mt-4 grid grid-cols-[1fr_auto] gap-y-2 text-lg">
        {n.horario.linhas.map((l) => (<><dt>{l.dias}</dt><dd class="font-bold tabular-nums text-right">{l.horas}</dd></>))}
      </dl>
      <p class="mt-4">Em feriados o horário pode mudar; confirme pelo WhatsApp.</p>
    </div>
    <div class="bg-white rounded-[20px] p-6">
      <h2 class="text-[length:var(--t-h3)]">Telefones</h2>
      <ul class="mt-4 grid gap-3 text-lg">
        <li>WhatsApp<br /><a class="font-bold" href={`https://wa.me/${n.whatsapp.numero}`}>{n.whatsapp.exibir}</a></li>
        <li>Telefone<br /><a class="font-bold" href={`tel:${n.telefone.tel}`}>{n.telefone.exibir}</a></li>
        <li>Disk Ração<br /><a class="font-bold" href={`tel:${n.diskRacao.tel}`}>{n.diskRacao.exibir}</a></li>
      </ul>
    </div>
    <div class="bg-white rounded-[20px] p-6">
      <h2 class="text-[length:var(--t-h3)]">Redes</h2>
      <p class="mt-4 text-lg">Acompanhe as novidades no <a class="font-bold" href={n.instagram} rel="noopener noreferrer" target="_blank">Instagram @bichoforte</a>.</p>
    </div>
  </section>
</Base>
