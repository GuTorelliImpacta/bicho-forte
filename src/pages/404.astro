---
import Base from '../layouts/Base.astro';
---
<Base title="Página não encontrada | Bicho Forte" description="Esta página não existe. Volte para a página inicial da Bicho Forte.">
  <section class="pagina wrap py-24 grid gap-6">
    <h1 class="text-[length:var(--t-xl)]">Página não encontrada.</h1>
    <p class="text-xl">Esse endereço não existe. Volte ao início ou chame a gente no WhatsApp.</p>
    <a href="/" class="btn btn-marinho justify-self-start">Voltar ao início</a>
  </section>
</Base>
